<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="#FFFFFF">
    <TextView android:id="@+id/widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="14sp" android:textColor="#202040" />
    <TextView android:id="@+id/widget_row_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="3" android:textSize="12sp" android:textColor="#404060" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/widget_accept" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:textSize="12sp" />
        <Button android:id="@+id/widget_decline" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
